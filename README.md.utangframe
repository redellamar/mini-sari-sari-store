    private void deleteutangActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_deleteutangActionPerformed
        int row = table.getSelectedRow();   //mag selec row

        if (row == -1) {    //f wla nag selec
            JOptionPane.showMessageDialog(this, "Select an utang first.");
        } else {
            utang.removeRow(row);   //f naanay gi slec

        JOptionPane.showMessageDialog(this, "Utang Deleted!");
        }
    }//GEN-LAST:event_deleteutangActionPerformed

