    private void searchpipolActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_searchpipolActionPerformed
        String search = jTextField1.getText();  //para kwaon g type nko 

    for (int i = 0; i < table.getRowCount(); i++) {     //e chek ang mga rows 1by1

        String customer = table.getValueAt(i, 1).toString();    //kwaon ang value

        if (customer.equalsIgnoreCase(search)) {
            table.setRowSelectionInterval(i, i);    //e gihlight ang selected row
            return;
        }
    }

    JOptionPane.showMessageDialog(this, "Customer not found.");
    }//GEN-LAST:event_searchpipolActionPerformed

    private void addutangActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_addutangActionPerformed
         String id = JOptionPane.showInputDialog("Enter ID:");      //para naay mo pupop na box
    String customer = JOptionPane.showInputDialog("Enter Customer Name:");
    String items = JOptionPane.showInputDialog("Enter Items:");
    String amount = JOptionPane.showInputDialog("Enter Amount:");
    String date = JOptionPane.showInputDialog("Enter Date:");
    String status = JOptionPane.showInputDialog("Enter Status:");

    utang.addRow(new Object[]{      //para ma add ang values na gi butang sa pop up
        id, customer, items, amount, date, status
    });

    JOptionPane.showMessageDialog(this, "Utang Added!");
    }//GEN-LAST:event_addutangActionPerformed

    private void editutangActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_editutangActionPerformed
         int row = table.getSelectedRow();  //mag selec og row

    if (row == -1) {    //f wla nag slec
        JOptionPane.showMessageDialog(this, "Select an utang first.");
        return;
    }

    String id = JOptionPane.showInputDialog("Enter ID:");   //pop up
    String customer = JOptionPane.showInputDialog("Enter Customer Name:");
    String items = JOptionPane.showInputDialog("Enter Items:");
    String amount = JOptionPane.showInputDialog("Enter Amount:");
    String date = JOptionPane.showInputDialog("Enter Date:");
    String status = JOptionPane.showInputDialog("Enter Status:");

    utang.setValueAt(id, row, 0);   //para  ma add sa table
    utang.setValueAt(customer, row, 1);
    utang.setValueAt(items, row, 2);
    utang.setValueAt(amount, row, 3);
    utang.setValueAt(date, row, 4);
    utang.setValueAt(status, row, 5);

    JOptionPane.showMessageDialog(this, "Utang Updated!");
    }//GEN-LAST:event_editutangActionPerformed

    private void gobakActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_gobakActionPerformed
        MainMenu main = new MainMenu();     //pra maka open ug new na window
    main.setVisible(true);      //tas mubalik a mainmenu, e remove ang utang na window

    this.dispose();
    }//GEN-LAST:event_gobakActionPerformed

