    private void searchActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_searchActionPerformed
         String search = PROsearch.getText();   //kwaon gi type sa user then e store sa varible na search

    for (int i = 0; i < TABLE.getRowCount(); i++) { //chek each row

        String name = TABLE.getValueAt(i, 1).toString();    //kwaon an value sa name sa product para ma serch

        if (name.equalsIgnoreCase(search)) {    //compare kun ang gi type ba kay same sa existing na na value
            TABLE.setRowSelectionInterval(i, i);    //e highlight ang na select na row
            return;     //stap da serch na since nakita nmn ang da one
        }
    }

    JOptionPane.showMessageDialog(this, "Product not found.");
    }//GEN-LAST:event_searchActionPerformed

