    private void addproductsActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_addproductsActionPerformed
        String id = JOptionPane.showInputDialog("Enter ID:");               //
        String name = JOptionPane.showInputDialog("Enter Product Name:");   //
        String category = JOptionPane.showInputDialog("Enter Category:");   //para naay mu pop na box up tas mangayu sa id, name, chuchu
        String price = JOptionPane.showInputDialog("Enter Price:");         //
        String stock = JOptionPane.showInputDialog("Enter Stock:");         //

     products.addRow(new Object[]{      //if ever nakoy gi add, then e dungag nya akong gi input sa table
        id, name, category, price, stock    //gi input nko na bago sa id, name, chuchu
    });

    JOptionPane.showMessageDialog(this, "Product Added!");  //ma show ni sha na message if done na na add sa table
    }//GEN-LAST:event_addproductsActionPerformed

