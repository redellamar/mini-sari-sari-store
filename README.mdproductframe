    private void EDITActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_EDITActionPerformed
         int row = TABLE.getSelectedRow(); // chek niya kun unsa na row gi selec

    if (row == -1) {    //-1 means walay gi pili
        JOptionPane.showMessageDialog(this, "Select a product first.");
        return;
    }

    String id = JOptionPane.showInputDialog("Enter ID:");       //show og pop op box para maka change/edit ko
    String name = JOptionPane.showInputDialog("Enter Product Name:");
    String category = JOptionPane.showInputDialog("Enter Category:");
    String price = JOptionPane.showInputDialog("Enter Price:");
    String stock = JOptionPane.showInputDialog("Enter Stock:");

    products.setValueAt(id, row, 0);        //change id sa gi sselc na row
    products.setValueAt(name, row, 1);
    products.setValueAt(category, row, 2);
    products.setValueAt(price, row, 3);
    products.setValueAt(stock, row, 4);

    JOptionPane.showMessageDialog(this, "Product Updated!");
    }//GEN-LAST:event_EDITActionPerformed

    private void REMOVEActionPerformed(java.awt.event.ActionEvent evt) {//GEN-FIRST:event_REMOVEActionPerformed
        int row = TABLE.getSelectedRow();   //kwaon ang g selec na row

        if (row == -1) {    //wla nag selec
            JOptionPane.showMessageDialog(this, "Select a product first.");
        } else {
        products.removeRow(row);    //e delet ang gi selec
        JOptionPane.showMessageDialog(this, "Product Removed!");
        }
    }//GEN-LAST:event_REMOVEActionPerformed

